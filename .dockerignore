# =============================================================================
# Исключения из контекста сборки
#
# Без этого файла COPY . . (Dockerfile) тащит в образ node_modules,
# каталог IDE и локальные артефакты сборки.
# =============================================================================

# Зависимости: ставятся внутри образа
node_modules
web/node_modules

# Артефакты сборки: собираются внутри образа, наружу копировать нечего.
# dist — сборка NestJS-сервера, web/dist — статика интерфейса.
dist
web/dist

# Системы контроля версий и IDE
.git
.gitignore
.idea

# Локальное окружение и секреты
.env
.env.*
!.env.example

# Логи и данные
*.log
audit.log
data

# Документация и тесты не нужны в runtime-образе
docs
tests
*.md

# Файлы compose и Docker: в образ не копируются
docker-compose*.yml
Dockerfile
.dockerignore
