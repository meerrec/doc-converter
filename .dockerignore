# =============================================================================
# Исключения из контекста сборки
#
# Без этого файла COPY . . (Dockerfile) тащит в образ node_modules,
# каталог IDE и локальные артефакты сборки.
#
# Шаблоны без ведущего слэша сопоставляются с путём целиком, поэтому `dist`
# исключил бы только каталог в корне: сборки лежат в apps/*/dist
# и packages/*/dist, и нужен шаблон `**`.
# =============================================================================

# Зависимости: ставятся внутри образа
node_modules
**/node_modules

# Артефакты сборки: собираются внутри образа, наружу копировать нечего
**/dist

# Байткод Python: `COPY . .` в Dockerfile воркера затащил бы его в образ,
# хотя он собран другой версией интерпретатора и всё равно перезапишется
**/__pycache__
**/*.pyc

# Системы контроля версий и IDE
.git
.gitignore
.idea

# Локальное окружение и секреты
.env
.env.*
!.env.example

# Логи и данные
*.log
audit.log
data

# Документация и тесты не нужны в runtime-образе
docs
tests
*.md

# Файлы compose и Docker: в образ не копируются
docker-compose*.yml
Dockerfile
.dockerignore
