# =============================================================================
# Исключения для системы контроля версий
#
# В репозиторий попадает только исходный код, конфигурация и документация.
# Зависимости, артефакты сборки, локальное окружение и runtime-данные
# воспроизводятся из package.json / docker compose и в истории не нужны.
# =============================================================================

# --- Зависимости -------------------------------------------------------------
# Ставятся локально и внутри образа; в pnpm-lock.yaml зафиксированы версии.
# Шаблон без ведущего слэша накрывает node_modules любого пакета workspace.
node_modules/

# Служебные каталоги пакетных менеджеров
.pnpm-store/
.yarn/
.yarnrc.yml
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Артефакты сборки --------------------------------------------------------
# Шаблон без ведущего слэша накрывает dist каждого пакета и приложения:
# apps/*/dist — сборки приложений, packages/*/dist — сборки библиотек.
dist/
build/

# Кеши сборщиков и инкрементальная информация TypeScript
.vite/
*.tsbuildinfo

# --- Локальное окружение и секреты -------------------------------------------
# .env.example — источник истины по переменным, он в репозитории остаётся.
.env
.env.*
!.env.example

# --- Логи и аудит ------------------------------------------------------------
# AUDIT_LOG_PATH по умолчанию /var/log/converter/audit.log (см. .env.example).
*.log
logs/
audit.log

# --- Runtime-данные ----------------------------------------------------------
# STORAGE_PATH — результаты конвертации; в контейнере это volume, не репозиторий.
# Шаблоны привязаны к корню (/): без слэша storage/ накрыл бы любой каталог
# с таким именем, включая packages/storage с исходниками.
/data/
/storage/
/results/

# Незавершённые записи: fileStorage.js пишет .tmp и переименовывает в целевой файл.
*.tmp

# Скачанные результаты конвертации: имена вида {taskId}.pdf из GET /results.
# Правило привязано к корню — документация и фикстуры в подкаталогах не задеты.
/*.pdf

# --- Тесты и покрытие --------------------------------------------------------
coverage/
.nyc_output/
junit.xml
test-report.xml
.jest-cache/

# --- IDE и редакторы ---------------------------------------------------------
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# Локальные (не разделяемые с командой) настройки Claude Code
.claude/settings.local.json
.claude/*.local.*

# --- Операционная система ----------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
desktop.ini
