{
  // Конфигурация веб-интерфейса: сборка идёт через Vite, `tsc` используется
  // только как проверка типов (`npm run typecheck`), поэтому `noEmit`.
  //
  // Строгость проверок — в общей базе workspace.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
