{
  // ===========================================================================
  // Общая база конфигурации TypeScript для всех пакетов workspace.
  //
  // Здесь только то, что обязано совпадать у всех: цель компиляции и строгость
  // проверок. Расхождение по этим опциям означает, что один и тот же код
  // принимается в одном пакете и отвергается в другом, — а именно так
  // и разошлись конфиги до появления этой базы: `noUncheckedIndexedAccess`
  // и `noUnusedParameters` были объявлены в корне и в контракте, но не в web.
  //
  // Чего здесь намеренно нет:
  // - `module` и `moduleResolution` — сервер собирается под Node (`NodeNext`),
  //   веб под бандлер (`ESNext` + `bundler`), это разные среды;
  // - `lib` — серверу нужен только ES, вебу ещё DOM;
  // - `jsx`, `outDir`, `rootDir`, `declaration` — принадлежат конкретному пакету;
  // - `esModuleInterop` — в корне он включён, в web нет, и включение меняет
  //   правила импорта CJS: это осознанное различие, а не дублирование.
  //
  // Значения подобраны так, чтобы подключение базы ничего не меняло в текущей
  // сборке: набор опций совпадает с тем, что уже был объявлен во всех трёх
  // пакетах. Строгость повышается здесь — сразу для всех.
  // ===========================================================================
  "compilerOptions": {
    "target": "ES2022",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    // Раньше был объявлен только в корне; значение совпадает с умолчанием
    // TypeScript 5, поэтому объявление ничего не меняет и лишь фиксирует
    // намерение — регистр в путях обязан совпадать
    "forceConsistentCasingInFileNames": true,

    // Проверка типов в `.d.ts` зависимостей не входит в нашу зону
    // ответственности, а время сборки растёт заметно
    "skipLibCheck": true
  }
}
