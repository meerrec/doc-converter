# =============================================================================
# Переменные окружения сервиса конвертации XLSX/DOCX → PDF.
#
# Источник истины по значениям — packages/config/src/index.ts: там у каждой
# константы есть обоснование. Файл перечисляет то, что имеет смысл менять
# при развёртывании.
#
# Значения ниже совпадают с docker-compose.yml, поэтому локальный запуск
# без .env работает «из коробки».
# =============================================================================

# --- Общие -------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# --- Valkey / Redis ----------------------------------------------------------
# Очередь BullMQ и состояние задач
REDIS_HOST=valkey
REDIS_PORT=6379

# --- Объектное хранилище (MinIO / S3) ----------------------------------------
S3_ENDPOINT=minio
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=conversions
S3_REGION=us-east-1

# Адрес, который попадёт в presigned-ссылку. Подпись включает хост, поэтому
# снаружи нужно имя, доступное клиенту (в compose — localhost)
S3_PUBLIC_ENDPOINT=localhost
S3_PUBLIC_PORT=9000
S3_PUBLIC_USE_SSL=false

# Время жизни ссылки на результат, секунды
PRESIGN_EXPIRY_SEC=3600
# Время жизни записи о задаче, секунды
JOB_TTL_SEC=86400

# --- Очереди -----------------------------------------------------------------
# Базовое имя очередей: полное имя — "<prefix>.<tier>"
QUEUE_PREFIX=xlsx2pdf
# Очередь, которую обслуживает воркер: light | medium | heavy
WORKER_QUEUE=light

# --- Пороги сложности --------------------------------------------------------
# Ниже обоих порогов — light, ниже вторых — medium, иначе heavy.
# Листы — для книг XLSX, страницы — для документов DOCX
COMPLEXITY_LIGHT_MAX_BYTES=2097152
COMPLEXITY_LIGHT_MAX_SHEETS=3
COMPLEXITY_LIGHT_MAX_PAGES=5
COMPLEXITY_MEDIUM_MAX_BYTES=20971520
COMPLEXITY_MEDIUM_MAX_SHEETS=20
COMPLEXITY_MEDIUM_MAX_PAGES=30

# --- Конвертация -------------------------------------------------------------
MAX_FILE_BYTES=104857600
MIN_OUTPUT_BYTES=32
CONVERSION_TIMEOUT_MS=120000
# Бюджет конвертации для тяжёлой очереди
CONVERSION_TIMEOUT_MS_HEAVY=300000

# --- UNO / LibreOffice -------------------------------------------------------
# Только loopback: у UNO нет аутентификации
UNO_HOST=127.0.0.1
UNO_PORT=2002
UNO_SCRIPT_PATH=/app/docker/uno/uno_convert.py
UNO_CONNECT_TIMEOUT_MS=30000
PYTHON_BIN=python3

# --- BullMQ ------------------------------------------------------------------
BULLMQ_LOCK_DURATION=240000
BULLMQ_STALLED_INTERVAL=120000
BULLMQ_MAX_STALLED_COUNT=1
JOB_ATTEMPTS=1
FAILED_JOB_TTL_SEC=86400
MAX_FAILED_JOBS=1000

# --- Ограничитель частоты ----------------------------------------------------
RATE_PER_SEC=5
RATE_BURST=20
# За прокси (nginx) выставить 1: иначе все клиенты делят одно ведро
TRUST_PROXY=false

# --- Автомасштабирование (docker-compose) ------------------------------------
DOCKER_SOCKET_PATH=/var/run/docker.sock
# GID сокета Docker. На Linux — группа docker: `getent group docker | cut -d: -f3`
# (обычно 998 или 999). На macOS в Docker Desktop сокет принадлежит root:root,
# то есть нужно 0: `stat -c '%g' /var/run/docker.sock`
DOCKER_GID=999
AUTOSCALER_WORKER_IMAGE=doc-converter-uno-worker:latest
AUTOSCALER_NETWORK=doc-converter_converter
AUTOSCALER_POLL_INTERVAL_MS=15000
AUTOSCALER_MAX_STEP=1
# Предельное ожидание ответа Docker API. Меньше периода опроса, чтобы
# зависший запрос стоил не более одного пропущенного цикла
DOCKER_API_TIMEOUT_MS=10000
# Время жизни отметки о снижении числа реплик в Valkey. Больше самого
# долгого cooldown (10 минут у тяжёлой очереди)
AUTOSCALER_COOLDOWN_TTL_SEC=3600
WORKER_MEMORY_LIMIT_MB=2048

# --- Логирование -------------------------------------------------------------
LOG_LEVEL=info
AUDIT_LOG_PATH=/var/log/converter/audit.log
