# =============================================================================
# Конфигурация сервиса конвертации документов
# =============================================================================

# Общие настройки
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# =============================================================================
# Valkey / Redis
# =============================================================================
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Настройки подключения (для BullMQ)
REDIS_CONNECTION_STRING=redis://valkey:6379/0

# =============================================================================
# Storage
# =============================================================================
STORAGE_PATH=/data/storage
MAX_FILE_BYTES=104857600
MAX_BODY_BYTES=52428800

# =============================================================================
# WASM и конвертация
# =============================================================================
# Путь к WASM библиотеке (если нужно кастомное расположение)
WASM_PATH=

# Включен ли синхронный режим
SYNC_ENABLED=true

# =============================================================================
# Таймауты (в миллисекундах)
# =============================================================================
# ВНИМАНИЕ: SYNC_TIMEOUT_MS должен быть МЕНЬШЕ таймаута балансировщика
# (nginx proxy_read_timeout, HAProxy timeout server)

# Общий бюджет синхронного запроса
SYNC_TIMEOUT_MS=30000

# Таймаут ожидания слота в семафоре
SYNC_QUEUE_WAIT_MS=5000

# Таймаут приема тела запроса
REQUEST_BODY_TIMEOUT_MS=15000

# Таймаут загрузки файла по URL
FETCH_TIMEOUT_MS=30000

# Таймаут валидации контента
VALIDATION_TIMEOUT_MS=10000

# Таймаут записи результата
STORAGE_WRITE_TIMEOUT_MS=5000

# Таймаут выполнения задачи (для sync и async)
JOB_TIMEOUT_MS=60000

# =============================================================================
# Rate Limiting
# =============================================================================
# Sliding window per IP
RATE_PER_SEC=5
RATE_BURST=20

# =============================================================================
# Fork Pool и изоляция
# =============================================================================
# Размер пула форкнутых процессов
FORK_POOL_SIZE=4

# Максимальное количество одновременных задач на воркер
MAX_CONCURRENT=4

# Лимит памяти для isolated-vm (в МБ)
ISOLATE_MEMORY_MB=512

# =============================================================================
# BullMQ настройки
# =============================================================================
# Время блокировки задачи
BULLMQ_LOCK_DURATION=120000

# Интервал проверки зависших задач
BULLMQ_STALLED_INTERVAL=60000

# Максимум повторных попыток для зависших задач
BULLMQ_MAX_STALLED_COUNT=1

# =============================================================================
# Логирование
# =============================================================================
LOG_LEVEL=info
AUDIT_LOG_PATH=/var/log/converter/audit.log

# =============================================================================
# CORS и безопасности
# =============================================================================
# Разрешенные origin (через запятую, пусто = все)
ALLOWED_ORIGINS=

# =============================================================================
# Идемпотентность
# =============================================================================
# Время жизни резервирования taskId (в секундах)
IDEMPOTENCY_TTL_SEC=3600

# =============================================================================
# Node.js опции
# =============================================================================
# Для worker контейнеров
NODE_OPTIONS=--disable-wasm-trap-handler --max-old-space-size=1536
