# =============================================================================
# Конфигурация сервиса конвертации документов
# =============================================================================

# Общие настройки
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# =============================================================================
# Valkey / Redis
# =============================================================================
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Настройки подключения (для BullMQ)
REDIS_CONNECTION_STRING=redis://valkey:6379/0

# =============================================================================
# Storage
# =============================================================================
STORAGE_PATH=/data/storage
# Каталог входных файлов очереди. Обязан лежать ВНЕ STORAGE_PATH: имена
# результатов собираются из клиентского `key`, и входной документ в общем
# каталоге стал бы доступен по GET /results/{key}.{ext}. Вложенность
# проверяется на старте приложения (src/config/index.ts)
INPUT_STORAGE_PATH=/data/incoming
# Время жизни входного файла на диске (мс) — столько он ждёт конвертации
INPUT_FILE_TTL_MS=3600000
# Период уборки осиротевших входных файлов (мс)
INPUT_CLEANUP_INTERVAL_MS=600000
MAX_FILE_BYTES=104857600
MAX_BODY_BYTES=52428800

# =============================================================================
# WASM и конвертация
# =============================================================================
# Путь к WASM библиотеке (если нужно кастомное расположение)
WASM_PATH=

# Включен ли синхронный режим
SYNC_ENABLED=true

# =============================================================================
# Таймауты (в миллисекундах)
# =============================================================================
# ВНИМАНИЕ: SYNC_TIMEOUT_MS должен быть МЕНЬШЕ таймаута балансировщика
# (nginx proxy_read_timeout, HAProxy timeout server)

# Общий бюджет синхронного запроса
SYNC_TIMEOUT_MS=30000

# Таймаут ожидания слота в семафоре
SYNC_QUEUE_WAIT_MS=5000

# Таймаут приема тела запроса
REQUEST_BODY_TIMEOUT_MS=15000

# Таймаут загрузки файла по URL
FETCH_TIMEOUT_MS=30000

# Таймаут валидации контента
VALIDATION_TIMEOUT_MS=10000

# Таймаут записи результата
STORAGE_WRITE_TIMEOUT_MS=5000

# Таймаут выполнения задачи (для sync и async)
JOB_TIMEOUT_MS=60000

# =============================================================================
# Rate Limiting
# =============================================================================
# Sliding window per IP
RATE_PER_SEC=5
RATE_BURST=20

# Значение настройки trust proxy для Express. По умолчанию false — заголовку
# X-Forwarded-For не доверяем. За прокси (nginx) выставить 1: иначе req.ip
# у всех клиентов равен адресу прокси, и они делят одно ведро ограничителя
TRUST_PROXY=false

# Предельное число идентификаторов в одном запросе статусов
MAX_STATUS_BATCH_IDS=64

# Заголовок Retry-After при недоступном Valkey (в секундах)
STORAGE_RETRY_AFTER_SEC=5

# =============================================================================
# Fork Pool и изоляция
# =============================================================================
# Размер пула форкнутых процессов.
# Библиотека конвертера 2.x держит ~1.16 ГБ на процесс, поэтому значение
# ограничено mem_limit контейнера (3 ГБ в compose): больше двух не влезает
FORK_POOL_SIZE=2

# Максимальное количество одновременных задач на воркер
MAX_CONCURRENT=2

# =============================================================================
# BullMQ настройки
# =============================================================================
# Время блокировки задачи
BULLMQ_LOCK_DURATION=120000

# Интервал проверки зависших задач
BULLMQ_STALLED_INTERVAL=60000

# Максимум повторных попыток для зависших задач
BULLMQ_MAX_STALLED_COUNT=1

# Сколько живёт упавшая задача в очереди (в секундах)
FAILED_JOB_TTL_SEC=86400

# Предельное число упавших задач в очереди
MAX_FAILED_JOBS=1000

# =============================================================================
# Защита воркера от переполнения памяти Valkey
# =============================================================================
# Пауза воркера при отказе Valkey по памяти (мс). На это время воркер
# не берёт задачи и не пишет в Redis, чтобы не усугублять переполнение
WORKER_OOM_PAUSE_MS=30000

# Доля maxmemory, при превышении которой воркер предупреждает о памяти
# при старте. Проверка пропускается, только если maxmemory не задан
VALKEY_MEMORY_WARN_RATIO=0.9

# =============================================================================
# Логирование
# =============================================================================
LOG_LEVEL=info
AUDIT_LOG_PATH=/var/log/converter/audit.log

# =============================================================================
# CORS и безопасности
# =============================================================================
# Разрешенные origin (через запятую, пусто = все)
ALLOWED_ORIGINS=

# =============================================================================
# Идемпотентность
# =============================================================================
# Время жизни резервирования taskId (в секундах)
IDEMPOTENCY_TTL_SEC=3600

# =============================================================================
# Node.js опции
# =============================================================================
# Для worker контейнеров
NODE_OPTIONS=--disable-wasm-trap-handler --max-old-space-size=1536
