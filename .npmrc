# =============================================================================
# Настройки pnpm для рабочего пространства.
#
# Файл project-level: перечисленные здесь параметры переопределяют глобальные,
# остальные (реестр, токены) продолжают браться из пользовательского конфига.
# =============================================================================

# Требования к версии Node из `engines` становятся обязательными.
#
# Без этого `engines` — только пожелание: pnpm печатает предупреждение и
# продолжает установку, а несовместимость всплывает позже и в другом месте —
# на этапе сборки `dist`, где сообщение уже не связывает причину со следствием.
# Сервис требует Node 24 (нативное стирание типов, `node:test` в healthcheck),
# и на Node 22 падение было бы неочевидным.
engine-strict=true
