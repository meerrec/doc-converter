{
  // Конфигурация серверной части (api + worker).
  //
  // NestJS требует декораторов и метаданных о типах параметров, поэтому здесь
  // неприменимо нативное стирание типов Node 24 — нужен шаг сборки `tsc`.
  //
  // `allowJs` включён на время переезда: доменные модули (security/, queue/,
  // storage/, worker/) пока остаются на JavaScript, и их импортирует как
  // существующее Express-приложение, так и новое NestJS-приложение. Переводить
  // их в TypeScript раньше нельзя — у них два потребителя с разными правилами
  // импорта (`./x.js` против `./x.ts`). Когда Express-слой будет удалён,
  // `allowJs` снимается вместе с переименованием файлов.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // Декораторы NestJS
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    // Переездный режим: JS-модули компилируются наравне с TS и попадают в dist,
    // чтобы скомпилированный NestJS-код мог их импортировать
    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src/**/*.ts", "src/**/*.js"],
  "exclude": ["node_modules", "dist", "tests"]
}
