{
  // Контракт собирается в JS и объявления: его `dist` — рантайм-зависимость
  // сервера, а типы читает и веб-интерфейс.
  //
  // Строгость проверок и среда исполнения — в корневом `tsconfig.json`,
  // общем для всех серверных пакетов и приложений.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",

    // Контракт потребляют обе стороны, поэтому сборка обязана быть
    // предсказуемой для бандлера: `verbatimModuleSyntax` запрещает
    // синтаксис, который по-разному понимают tsc и Vite
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["src"]
}
