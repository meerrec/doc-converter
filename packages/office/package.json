{
  "name": "@doc-converter/office",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Движок браузерной конвертации: BetterOffice (Rust/WASM) и собственный экспортёр PDF",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@betteroffice/docx": "catalog:",
    "@betteroffice/fonts": "0.3.0",
    "@betteroffice/fonts-cjk": "0.3.0",
    "@betteroffice/xlsx": "0.3.0",
    "@doc-converter/contract": "workspace:*",
    "fast-png": "8.0.0",
    "fflate": "0.8.3",
    "harfbuzzjs": "1.6.2"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
