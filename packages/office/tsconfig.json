{
  // Движок браузерной конвертации: исполняется в браузере, но собирается
  // как библиотека — `tsc` в `dist`, откуда его берёт сборщик приложения.
  //
  // Отличие от серверных пакетов одно — `lib`: здесь есть DOM (canvas,
  // Worker, OffscreenCanvas) и структурированное клонирование. Остальное
  // (модульная система, объявления, строгость) — как у корневого `tsconfig.json`:
  // импорты с расширениями `.js` и предсказуемость вывода для бандлера.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "dist",
    "rootDir": "src",

    // Формат обмена между сборкой и обвязкой обязан пониматься одинаково
    // и `tsc`, и Vite: синтаксис, который они различают, здесь запрещён
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["src"]
}
