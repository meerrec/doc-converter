{
  "name": "doc-converter",
  "version": "1.0.0",
  "description": "Сервис конвертации документов, совместимый с Р7-Офис API. Работает исключительно через WASM-сборку LibreOffice.",
  "type": "module",
  "main": "dist/nest/main.js",
  "scripts": {
    "start:api": "node dist/nest/main.js",
    "start:worker": "node dist/worker/index.js",
    "start": "concurrently \"npm run start:api\" \"npm run start:worker\"",
    "dev:api": "NODE_ENV=development node dist/nest/main.js",
    "dev:worker": "NODE_ENV=development node dist/worker/index.js",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:worker\"",
    "test": "NODE_ENV=test LOG_LEVEL=silent AUDIT_LOG_LEVEL=error vitest run",
    "test:watch": "NODE_ENV=test LOG_LEVEL=silent AUDIT_LOG_LEVEL=error vitest",
    "test:e2e": "E2E=1 npm run test",
    "lint": "echo 'Linter not configured yet'",
    "health": "curl -s http://localhost:3000/health | jq",
    "build:contract": "pnpm --filter @doc-converter/contract build",
    "build:web": "pnpm --filter doc-converter-web build",
    "build:server": "tsc -p tsconfig.json",
    "typecheck:server": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "document-converter",
    "libreoffice",
    "wasm",
    "r7-office",
    "conversion",
    "pdf"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@doc-converter/contract": "workspace:*",
    "@matbee/libreoffice-converter": "^2.7.2",
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "bullmq": "^5.1.0",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "pino": "^8.17.2",
    "pino-http": "^8.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yauzl": "^2.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@swc/core": "^1.16.2",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.1",
    "@types/yauzl": "^2.10.3",
    "concurrently": "^8.2.2",
    "supertest": "^6.3.3",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.1",
    "yazl": "^2.5.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true
}
