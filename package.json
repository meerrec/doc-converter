{
  "name": "doc-converter",
  "version": "1.0.0",
  "description": "Сервис конвертации документов XLSX и DOCX → PDF через LibreOffice + UNO API",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "test": "NODE_ENV=test LOG_LEVEL=silent AUDIT_LOG_LEVEL=error vitest run",
    "test:watch": "NODE_ENV=test LOG_LEVEL=silent AUDIT_LOG_LEVEL=error vitest",
    "test:e2e": "E2E=1 npm run test",
    "lint": "eslint .",
    "health": "curl -s http://localhost:3000/health | jq",
    "start:api": "pnpm --filter @doc-converter/api start",
    "start:worker": "WORKER_QUEUE=${WORKER_QUEUE:-light} pnpm --filter @doc-converter/worker start",
    "start:autoscaler": "pnpm --filter @doc-converter/autoscaler start",
    "dev:api": "NODE_ENV=development pnpm --filter @doc-converter/api start",
    "dev:worker": "NODE_ENV=development pnpm --filter @doc-converter/worker start",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:worker\""
  },
  "keywords": [
    "document-converter",
    "libreoffice",
    "uno",
    "xlsx",
    "docx",
    "pdf"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.2",
    "@types/node": "catalog:",
    "concurrently": "^8.2.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "supertest": "^6.3.3",
    "typescript": "catalog:",
    "typescript-eslint": "^8.70.0",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.1",
    "yazl": "^2.5.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.21.0"
}
